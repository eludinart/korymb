{
  "name": "Korymb (backend + admin)",
  "user": "ubuntu",
  "install": "bash scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && ../.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8020"
    },
    {
      "name": "frontend",
      "command": "KORYMB_SKIP_VERIFY=1 npm --prefix admin run dev"
    }
  ]
}
