ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODELS=claude-sonnet-4-6,claude-3-5-haiku-latest
# Fournisseur actif: mistral | anthropic | openrouter
LLM_PROVIDER=mistral

# Mistral AI — fournisseur principal recommandé
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MODELS=ministral-8b-latest,mistral-small-latest,mistral-large-latest,open-mistral-nemo
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OpenRouter — option secondaire (agrégateur multi-fournisseurs)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODELS=google/gemma-3-27b-it:free,google/gemma-2-9b-it:free,google/gemma-7b-it:free,google/gemini-2.0-flash-exp:free,openai/gpt-4o-mini,google/gemini-2.5-flash-lite,anthropic/claude-3.5-haiku
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_API_SECRET=korymb-secret-2026
ENV=production

# Compte admin initial (optionnel — créé au 1er démarrage, espace legacy)
# KORYMB_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# KORYMB_BOOTSTRAP_ADMIN_PASSWORD=change_me_min_8_chars
# KORYMB_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin
# KORYMB_BOOTSTRAP_WORKSPACE_NAME=Mon Korymb

# Auth JWT (recommandé en prod SaaS — 32+ caractères)
# JWT_SECRET=

# Base backend Korymb (sqlite local ou MariaDB prod/VPS).
# Dev vers MariaDB Coolify sur VPS : copier .env.local.example -> .env.local + tunnel SSH
#   .\scripts\mariadb-vps-tunnel.ps1
# KORYMB_DB_ENGINE=mariadb
# KORYMB_DB_HOST=127.0.0.1
# KORYMB_DB_PORT=3307
# KORYMB_DB_USER=mariadb
# KORYMB_DB_PASSWORD=
# KORYMB_DB_NAME=default
KORYMB_DB_ENGINE=sqlite

# Base de données Fleur d'Amours (VPS — hostname interne Coolify)
FLEUR_DB_HOST=juehpsnqkm60d2o6dhs38c5t
FLEUR_DB_PORT=3306
FLEUR_DB_USER=mariadb
FLEUR_DB_PASSWORD=...
FLEUR_DB_NAME=default

# Réseaux sociaux (optionnel)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Agents autonomes — intégration Meta Webhooks (optionnel)
# Générer un token de Page longue durée dans Meta for Developers > Mes Apps > Webhooks
META_PAGE_ACCESS_TOKEN=
# Token de vérification à renseigner dans Meta for Developers > Webhooks (valeur libre)
META_WEBHOOK_VERIFY_TOKEN=korymb-webhook-2026

# Email SMTP (optionnel)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Newsletter Brevo (optionnel) — campagnes email marketing
BREVO_API_KEY=
BREVO_DEFAULT_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Élude In Art

# Traduction DeepL (optionnel)
DEEPL_API_KEY=

# Génération d'images (optionnel) — API OpenAI-compatible
IMAGE_GEN_MODEL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=

# Google Drive (optionnel)
# Token OAuth2 Bearer avec scope Drive (ex. https://www.googleapis.com/auth/drive.file)
# Laisse vide pour utiliser GOOGLE_API_ACCESS_TOKEN.
GOOGLE_DRIVE_ACCESS_TOKEN=
# Dossier cible par défaut (optionnel)
GOOGLE_DRIVE_FOLDER_ID=

# Google OAuth (multi-scope) — optionnel
# Source unique recommandée : un seul token OAuth avec scopes multiples.
GOOGLE_API_ACCESS_TOKEN=
# Renouvellement automatique (optionnel, recommandé)
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optionnel (par défaut https://oauth2.googleapis.com/token)
GOOGLE_OAUTH_TOKEN_ENDPOINT=
# Tokens dédiés par service (optionnels) — prioritaires s'ils sont définis.
GOOGLE_GMAIL_ACCESS_TOKEN=
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_DOCS_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEETS_DEFAULT_ID=

# Google Analytics GA4 (optionnel)
GA_PROPERTY_ID=
GOOGLE_ANALYTICS_ACCESS_TOKEN=

# Recherche web (optionnel — chaîne Tavily → Brave → DuckDuckGo)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# YouTube (optionnel)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# WhatsApp Business (optionnel)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# CRM — notion | hubspot (optionnel)
CRM_PROVIDER=
NOTION_API_KEY=
NOTION_CONTACTS_DATABASE_ID=
HUBSPOT_API_KEY=

# Paiements (optionnel)
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.paypal.com

# Tiime — facturation électronique (devis Korymb → facture Tiime via Make)
TIIME_MAKE_WEBHOOK_URL=

# Canva & Pinterest (optionnel)
CANVA_API_KEY=
CANVA_DEFAULT_TEMPLATE_ID=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# Messagerie & webhooks (optionnel)
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
KORYMB_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_URL=

# Synthèse vocale — openai | elevenlabs (optionnel)
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_OUTPUT_DIR=data/tts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
