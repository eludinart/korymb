# Modèle de production. Ne pas y mettre de secrets.
# Le fichier réel .env.production est ignoré par Git.
# Coolify injecte les variables ; ne jamais passer de secret en argument de build.

# URL publique du backend (visible du navigateur, ce n'est pas un secret).
NEXT_PUBLIC_KORYMB_API_URL=https://api-korymb.eludein.art

# Pas de secret agent sur le service frontend : le cockpit s'authentifie par cookie
# httpOnly (korymb_token) via les routes /api/korymb*. AGENT_API_SECRET reste sur le backend.
# Ne jamais définir NEXT_PUBLIC_KORYMB_AGENT_SECRET : Next intègre ce préfixe au JavaScript du navigateur.
