# Modèle de production. Ne pas y mettre de secrets.
# Le fichier réel .env.production est ignoré par Git.
# Coolify injecte les variables au runtime ; ne pas passer le secret agent en argument de build.

# URL publique du backend (visible du navigateur, ce n'est pas un secret).
NEXT_PUBLIC_KORYMB_API_URL=https://api-korymb.eludein.art

# Secret agent — processus Next uniquement. Même valeur que AGENT_API_SECRET (backend).
# Ne pas définir NEXT_PUBLIC_KORYMB_AGENT_SECRET : Next intègre ce préfixe au JavaScript du navigateur.
# Le cockpit s'authentifie par cookie JWT (korymb_token) via les routes /api/korymb*.
KORYMB_AGENT_SECRET=remplacer_par_openssl_rand_hex_32
