# ── Frontend Next.js (service Coolify — Dockerfile racine) ───────────────────
PORT=3000
NODE_ENV=production

# URL publique du backend (navigateur + proxy serveur)
NEXT_PUBLIC_KORYMB_API_URL=https://api-korymb.eludein.art
KORYMB_API_URL=https://api-korymb.eludein.art

# Pas de secret agent sur ce service. Le navigateur s'authentifie par cookie httpOnly.
# AGENT_API_SECRET reste sur le backend (clients machine).
# Ne jamais définir NEXT_PUBLIC_KORYMB_AGENT_SECRET : ce préfixe est intégré au JavaScript du navigateur.

# ── Backend FastAPI (service Coolify séparé — backend/Dockerfile) ─────────────
# ENV=production
# PORT=3000
# AGENT_API_SECRET=replace_with_long_random_secret
# JWT_SECRET=replace_with_jwt_secret_min_32_chars
# JWT_EXPIRE_HOURS=168
# KORYMB_DB_ENGINE=mariadb
# KORYMB_DB_HOST=...
# KORYMB_DB_PORT=3306
# KORYMB_DB_USER=...
# KORYMB_DB_PASSWORD=...
# KORYMB_DB_NAME=korymb
# KORYMB_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# KORYMB_BOOTSTRAP_ADMIN_PASSWORD=...
# KORYMB_BOOTSTRAP_WORKSPACE_NAME=Korymb — Legacy
# KORYMB_CORS_ORIGINS=https://korymb.eludein.art
